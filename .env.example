# Main site — registration form
# Google Apps Script "Web app" deployment URL (ends with /exec)
# See docs/GOOGLE_SHEETS_REGISTRATION.md for setup steps
VITE_REGISTRATION_SCRIPT_URL=

# Sponsorship section (/sponsor) — content API served by ./backend
# Defaults to https://dtw-backend.onrender.com/api when unset.
# For local development against a backend started with `npm run backend:dev`:
#   VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_BASE_URL=
